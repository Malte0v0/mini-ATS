# Copy to .env and fill in from Supabase dashboard > Project Settings > API Keys
# The publishable key is safe in the browser: RLS policies decide what it can access.
# NEVER put the secret key here: every VITE_ variable is bundled into the public JS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
